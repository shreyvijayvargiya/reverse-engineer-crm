{
  "name": "reverse-engineer-crm",
  "version": "0.1.0",
  "description": "Describe what you do online. A Claude agent reverse-engineers your workflow into a frontend CRM / dashboard codebase you own, with API stubs and AGENTS.md.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "rcrm": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    ".claude",
    "AGENTS.md",
    "DISCLAIMER.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "RCRM_E2E=1 vitest run tests/e2e.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
